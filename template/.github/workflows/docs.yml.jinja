name: docs

on:
{%- if with_pypi %}
  # Deploy on a stable release, so the site documents what PyPI serves rather
  # than unreleased work on main. Pre-releases build but do not deploy.
  release:
    types: [published]
{%- else %}
  push:
    branches: [main]
{%- endif %}
  # Build (but don't deploy) on PRs, so broken docs fail before merge.
  pull_request:
    branches: [main]
  # Deploy by hand. `ref` builds that tag or branch with this workflow, e.g. to
  # republish a release's docs: gh workflow run docs.yml -f ref=v0.2.0
  workflow_dispatch:
    inputs:
      ref:
        description: "Tag or branch to build (default: the ref the run is on)"
        required: false
        type: string

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
        with:
          ref: {% raw %}${{ inputs.ref || github.ref }}{% endraw %}
      - uses: astral-sh/setup-uv@v8.1.0
      # `docs` does not include rust-just, so install `just` separately here.
      - uses: extractions/setup-just@v4
      - run: uv sync --group docs --locked
      - run: uv run just docs
      - uses: actions/upload-pages-artifact@v4
        if: github.event_name != 'pull_request' && !github.event.release.prerelease
        with:
          path: site

  deploy:
    runs-on: ubuntu-latest
    needs: build
    if: github.event_name != 'pull_request' && !github.event.release.prerelease
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
    steps:
      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v4
        id: deployment
